# =============================================================================
# Configuration de la stack de monitoring Yanshee
# Copie ce fichier en ".env" puis adapte les valeurs.
#   (PowerShell)  Copy-Item .env.example .env
# =============================================================================

# --- Robot -------------------------------------------------------------------
# Adresse du robot qui sert capteurs_serveur.py (/capteurs, /batterie, /marche)
ROBOT_URL=http://10.124.7.2:8080
# Intervalle d'enregistrement en base + metriques (secondes)
POLL_INTERVAL=2
# Timeout des requetes vers le robot (secondes)
REQUEST_TIMEOUT=1.5
# Seuil d'obstacle / portee max de l'ultrason (cm) - utilises pour les metriques
SEUIL_CM=35
PORTEE_CM=400

# --- Base de donnees ---------------------------------------------------------
POSTGRES_USER=yanshee
POSTGRES_PASSWORD=yanshee
POSTGRES_DB=yanshee

# --- Grafana -----------------------------------------------------------------
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# --- Notifications -----------------------------------------------------------
# Canaux actifs : "email", "sms" ou "email,sms" (vide = auto selon la config)
NOTIFY_CHANNELS=email
# "true" pour tester sans rien envoyer (les messages sont loggues)
NOTIFY_DRY_RUN=false

# --- Email (SMTP) ------------------------------------------------------------
# Marche avec n'importe quel fournisseur (Gmail, Brevo, OVH, Outlook, Mailtrap...).
#
# Gmail : active la validation en 2 etapes puis cree un "mot de passe
#   d'application" (16 caracteres) a mettre dans SMTP_PASS.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_STARTTLS=true
# Brevo : SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
# OVH   : SMTP_HOST=ssl0.ovh.net  SMTP_PORT=465  SMTP_SSL=true  SMTP_STARTTLS=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=ton.adresse@gmail.com
SMTP_PASS=ton_mot_de_passe_application
SMTP_FROM=ton.adresse@gmail.com
SMTP_TO=destinataire1@exemple.com,destinataire2@exemple.com
SMTP_STARTTLS=true
SMTP_SSL=false

# --- SMS (API Free Mobile, optionnel) ----------------------------------------
# Uniquement vers ta propre ligne Free (Espace abonne > Mes options >
# Notifications par SMS). Laisse vide si tu n'utilises que l'email.
FREE_MOBILE_USER=
FREE_MOBILE_PASS=
# FREE_MOBILE_ACCOUNTS=[{"user":"12345678","pass":"cleA","nom":"Alice"}]
FREE_MOBILE_ACCOUNTS=
